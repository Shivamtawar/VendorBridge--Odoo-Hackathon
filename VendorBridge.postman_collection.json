{
  "info": {
    "_postman_id": "vendorbridge-api-collection",
    "name": "VendorBridge API",
    "description": "Complete API collection for VendorBridge Procurement & Vendor Management ERP\n\nRoles:\n- admin: User/vendor management, audit logs, reports\n- procurement_officer: RFQ lifecycle, PO generation, invoice generation\n- manager: View RFQs/quotations, approve/reject procurement requests\n- vendor: Submit quotations, view assigned RFQs and POs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:3000/api", "type": "string" },
    { "key": "adminToken",   "value": "", "type": "string" },
    { "key": "officerToken", "value": "", "type": "string" },
    { "key": "managerToken", "value": "", "type": "string" },
    { "key": "vendorToken",  "value": "", "type": "string" },
    { "key": "rfqId",        "value": "", "type": "string" },
    { "key": "vendorId",     "value": "", "type": "string" },
    { "key": "quotationId",  "value": "", "type": "string" },
    { "key": "approvalId",   "value": "", "type": "string" },
    { "key": "poId",         "value": "", "type": "string" },
    { "key": "invoiceId",    "value": "", "type": "string" }
  ],
