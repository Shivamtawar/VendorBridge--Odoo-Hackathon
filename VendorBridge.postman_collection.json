            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Office Laptops Procurement\",\n  \"description\": \"Need 50 laptops for the engineering team\",\n  \"quantity\": 50,\n  \"unit\": \"units\",\n  \"deadline\": \"2026-07-01\",\n  \"vendor_ids\": [],\n  \"items\": [\n    {\n      \"item_name\": \"Dell Laptop 15 inch\",\n      \"quantity\": 30,\n      \"unit\": \"units\",\n      \"description\": \"i7, 16GB RAM, 512GB SSD\"\n    },\n    {\n      \"item_name\": \"MacBook Pro M3\",\n      \"quantity\": 20,\n      \"unit\": \"units\",\n      \"description\": \"M3 chip, 16GB RAM, 512GB SSD\"\n    }\n  ]\n}" },
